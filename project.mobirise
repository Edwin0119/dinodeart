            ".item-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-flow": "column nowrap",
              "margin-bottom": "2rem"
            },
            ".mbr-section-btn": {
              "margin-top": "1rem !important",
              "text-align": "center"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              },
              ".item-wrapper": {
                "margin-bottom": "0rem",
                "margin-top": "0rem"
              },
              ".mbr-section-btn": {
                "margin-top": "3rem !important"
              }
            },
            ".mbr-section-title": {
              "color": "#4c2306"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            },
            ".item-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-subtitle": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".content-head": {
              "max-width": "800px"
            },
            "@media (max-width: 767px)": {
              ".item-wrapper": {
                "margin-bottom": "1rem",
                "padding": "0"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#4c2306"
            }
